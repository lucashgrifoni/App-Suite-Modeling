{
  "name": "otm-web",
  "private": true,
  "version": "7.6.4",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:portable": "node ./node_modules/vite/bin/vite.js build",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "typecheck:portable": "node ./node_modules/typescript/bin/tsc --noEmit",
    "contracts:export": "python ../../scripts/export_openapi.py",
    "contracts:generate": "node ./node_modules/openapi-typescript/bin/cli.js ../../contracts/openapi.json -o src/types/generated/openapi.d.ts",
    "contracts:sync": "npm run contracts:export && npm run contracts:generate",
    "contracts:verify": "python ../../scripts/verify_openapi_up_to_date.py",
    "contracts:check": "node scripts/contracts-check.mjs",
    "ci:build": "npm run typecheck && npm run build",
    "ci:build:portable": "npm run typecheck:portable && npm run build:portable",
    "e2e:smoke": "node ./node_modules/@playwright/test/cli.js test e2e/smoke.spec.ts --project=chromium",
    "e2e:critical": "node ./node_modules/@playwright/test/cli.js test e2e/smoke.spec.ts e2e/cockpit.spec.ts e2e/journeys.spec.ts e2e/import.spec.ts --project=chromium",
    "e2e:hybrid:check": "python ../../scripts/check_hybrid_prereqs.py",
    "e2e:hybrid": "npm run e2e:hybrid:check && node ./node_modules/@playwright/test/cli.js test e2e/hybrid.spec.ts --config playwright.hybrid.config.ts --project=chromium",
    "e2e:complement": "node ./node_modules/@playwright/test/cli.js test e2e/release.spec.ts --project=chromium",
    "e2e:phase4": "node ./node_modules/@playwright/test/cli.js test e2e/diagram.spec.ts e2e/pdf.spec.ts e2e/history.spec.ts --project=chromium",
    "e2e:smoke:portable": "node ./node_modules/@playwright/test/cli.js test e2e/smoke.spec.ts --project=chromium",
    "e2e:smoke:headed": "node ./node_modules/@playwright/test/cli.js test e2e/smoke.spec.ts --project=chromium --headed",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "i18next": "^26.0.3",
    "jspdf": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.14.2",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.2",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.39",
    "tailwindcss": "3.4.19",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.3"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  }
}
